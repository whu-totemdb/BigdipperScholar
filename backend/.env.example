AGENT_BACKEND=research_report
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Enable only if your chat-completions provider supports these fields.
LLM_SEND_THINKING=false
LLM_SEND_REASONING_EFFORT=false
BIGDIPPER_AGENT_EXPERIMENT_LLM_TIMEOUT=120
BIGDIPPER_RESEARCH_REPORT_CHAT_MAX_ROUNDS=8
BIGDIPPER_AGENT_TOOL_WORKERS=4
BIGDIPPER_DB_PATH=runtime/workspaces.db

# Your PostgreSQL-wire-compatible MMDB. Use a read-only role.
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSLMODE=prefer
BIGDIPPER_DB_STATEMENT_TIMEOUT_MS=60000
BIGDIPPER_DB_CONNECT_TIMEOUT_SECONDS=5

# generic: schema discovery + general MMSQL + in-database vector queries.
# cn: additionally expose the retained CN-specific scholarly tools.
BIGDIPPER_DATA_PROFILE=generic
BIGDIPPER_DB_SCHEMA=public
BIGDIPPER_TABLE_PREFIX=
BIGDIPPER_SCHEMA_NOTES_PATH=
# Operator-written SQL with %(embedding)s and %(limit)s parameters.
BIGDIPPER_SEMANTIC_SQL_PATH=
# Same MMDB connection as DB_*. Configure these for your corpus.
# CN profile defaults to cn_paper_embeddings_full_hnsw(paperid, embedding).
BIGDIPPER_VECTOR_TABLE=
BIGDIPPER_VECTOR_ID_COLUMN=paperid
BIGDIPPER_VECTOR_COLUMN=embedding
BIGDIPPER_EMBEDDING_BASE_URL=
BIGDIPPER_EMBEDDING_MODEL=
BIGDIPPER_EMBEDDING_API_KEY=
BIGDIPPER_EMBEDDING_DIMENSIONS=
# custom expects POST /embed {query}; openai expects POST /embeddings.
BIGDIPPER_EMBEDDING_PROTOCOL=custom
BIGDIPPER_MCP_QUERY_CACHE_TTL_SECONDS=30
# Optional path to a local MCP config for remote/custom databases.
# BIGDIPPER_MCP_CONFIG=mcp_servers.local.yaml
# Separate, optional DB_Tools alternative; never loaded by the main method.
# BIGDIPPER_DB_TOOLS_MCP_CONFIG=mcp_servers.db-tools.local.yaml
